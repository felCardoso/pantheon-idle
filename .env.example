# Supabase Dashboard -> Settings -> API
# Public — safe to expose to the browser, used by src/lib/supabaseClient.ts.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Secret — server-only, never prefix this with NEXT_PUBLIC_. Used by lib/supabase-admin.ts
# to bypass RLS from inside app/api/** route handlers. Supabase Dashboard -> Settings -> API
# -> Project API keys -> service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
